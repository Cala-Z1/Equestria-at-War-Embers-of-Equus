guiTypes = {
	containerWindowType = {
		name = "CRY_corruption_window"
		position = { x = 5 y = 55 }
		size = { width = 250 height = 320 }
		orientation = upper_right
		OrientedPosition = upper_right
		clipping = no

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_b"
		}

		# Title bar
		instantTextBoxType = {
			name = "corruption_title"
			position = { x = 10 y = 8 }
			font = "hoi_20b"
			text = "CRY_CORRUPTION_TITLE"
			maxWidth = 230
			maxHeight = 30
			format = center
		}

		# Crystal Heart icon
		iconType = {
			name = "crystal_heart_icon"
			spriteType = "GFX_idea_crystal_heart"
			position = { x = 100 y = 38 }
		}

		# Gauge background
		iconType = {
			name = "gauge_bg"
			spriteType = "GFX_national_emergency_crisis_gauge_bg"
			position = { x = 20 y = 75 }
		}

		# Gauge fill — driven by corruption variable
		progressbarType = {
			name = "corruption_gauge"
			position = { x = 24 y = 79 }
			size = { width = 202 height = 25 }
			color = { r=0.7 g=0.1 b=0.7 a=1 }  # purple for corruption
			colortwo = { r=0.2 g=0.8 b=0.9 a=1 } # cyan for purity
			leftcrop = 0.0
			rightcrop = 1.0
			variable = CRY_corruption_level
			max_variable = 100
		}

		# Corruption level label
		instantTextBoxType = {
			name = "corruption_label"
			position = { x = 10 y = 108 }
			font = "hoi_16mbs"
			text = "CRY_CORRUPTION_LABEL"
			maxWidth = 230
			maxHeight = 20
			format = center
		}

		# Corruption value display
		instantTextBoxType = {
			name = "corruption_value"
			position = { x = 10 y = 126 }
			font = "hoi_20b"
			text = "[CRY_corruption_level.GetValue]"
			maxWidth = 230
			maxHeight = 25
			format = center
		}

		# Divider
		iconType = {
			name = "divider"
			spriteType = "GFX_divider_line"
			position = { x = 10 y = 158 }
		}

		# Status text — changes by threshold
		instantTextBoxType = {
			name = "status_critical"
			position = { x = 10 y = 165 }
			font = "hoi_16mbs"
			text = "CRY_STATUS_CRITICAL"
			maxWidth = 230
			maxHeight = 60
			format = center
			visible = "[?CRY_corruption_panel.CRY_corruption_critical_trigger]"
		}

		instantTextBoxType = {
			name = "status_high"
			position = { x = 10 y = 165 }
			font = "hoi_16mbs"
			text = "CRY_STATUS_HIGH"
			maxWidth = 230
			maxHeight = 60
			format = center
			visible = "[?CRY_corruption_panel.CRY_corruption_high_trigger]"
		}

		instantTextBoxType = {
			name = "status_low"
			position = { x = 10 y = 165 }
			font = "hoi_16mbs"
			text = "CRY_STATUS_LOW"
			maxWidth = 230
			maxHeight = 60
			format = center
			visible = "[?CRY_corruption_panel.CRY_corruption_low_trigger]"
		}

		instantTextBoxType = {
			name = "status_purified"
			position = { x = 10 y = 165 }
			font = "hoi_16mbs"
			text = "CRY_STATUS_PURIFIED"
			maxWidth = 230
			maxHeight = 60
			format = center
			visible = "[?CRY_corruption_panel.CRY_corruption_purified_trigger]"
		}

		# Threshold markers
		instantTextBoxType = {
			name = "threshold_labels"
			position = { x = 10 y = 235 }
			font = "hoi_13"
			text = "CRY_THRESHOLD_LABELS"
			maxWidth = 230
			maxHeight = 50
			format = center
		}
	}
}
